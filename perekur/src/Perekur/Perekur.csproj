<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Perekur</AssemblyName>
    <RootNamespace>Perekur</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\perekur.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Перекур</Product>
    <Description>Перекур — напоминание сделать перерыв в работе: сигнал в выбранное время, интервалы повтора, диапазон времени и уведомление в панели уведомлений Windows.</Description>
    <NeutralLanguage>ru</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\perekur.ico" LogicalName="Perekur.Assets.perekur.ico" />
  </ItemGroup>

</Project>
